{
  "name": "questnote-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "serve": "node devtools/serve.mjs",
    "preview:deploy": "node scripts/deploy-preview.mjs",
    "release:production": "node scripts/release-production.mjs",
    "images:build": "node devtools/build-pet-images.mjs build",
    "images:check": "node devtools/build-pet-images.mjs check && node scripts/validate-expedition-images.mjs",
    "test": "node --test \"devtools/*.test.mjs\" && node devtools/v343-reveal-flow-logic-test.mjs",
    "pools:validate": "node scripts/validate-pool-content.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "card-pool": "node scripts/card-pool.mjs",
    "test:pool:release": "node devtools/card-pool-release-smoke.mjs",
    "test:browser": "node devtools/browser-test-server.mjs",
    "test:sw:browser": "node devtools/release-browser-server.mjs",
    "test:themes": "node --test devtools/theme-preferences.test.mjs devtools/theme-design.test.mjs",
    "test:feedback": "node --test devtools/feedback.test.mjs devtools/feedback-backend.test.mjs",
    "test:feedback:browser": "node devtools/feedback-browser-server.mjs",
    "test:reminders": "node --test devtools/reminders.test.mjs",
    "test:reminders:runtime": "node node_modules/wrangler/bin/wrangler.js deploy --config backend/reminders/wrangler.jsonc --dry-run --outdir .dev-backups/reminder-worker && node devtools/reminders-runtime-test.mjs",
    "feedback:read": "node --use-system-ca scripts/read-feedback.mjs",
    "test:bond": "node --test devtools/bond-journey.test.mjs",
    "test:bond:browser": "node devtools/bond-journey-browser-test.mjs",
    "test:awakening": "node --test devtools/pet-awakening.test.mjs devtools/demon-final-task.test.mjs",
    "test:awakening:browser": "node devtools/pet-awakening-browser-test.mjs",
    "test:senior:browser": "node devtools/senior-mode-browser-test.mjs",
    "test:guided": "node --test devtools/guided-page-tour.test.mjs devtools/guided-onboarding.test.mjs",
    "lint": "eslint --max-warnings 0 src service-worker.js devtools scripts backend",
    "check": "npm run lint && node devtools/syntax-check.mjs && npm test && npm run pools:validate && npm run images:check",
    "ios:web": "node scripts/build-ios-web.mjs",
    "ios:icon": "node scripts/build-ios-icon.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "sharp": "0.35.4",
    "web-push": "3.6.7",
    "wrangler": "4.141.0"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  }
}
