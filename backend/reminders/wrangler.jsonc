{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "questnote-reminders",
  "account_id": "c759449ca02c133f573e85d838b8e960",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://leotsouo.github.io",
    "VAPID_SUBJECT": "https://leotsouo.github.io/questnote-pwa/"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "questnote-reminders" }],
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [{ "name": "API_RATE", "namespace_id": "209341516", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
