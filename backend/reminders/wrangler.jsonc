{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "questnote-reminders",
  "account_id": "c759449ca02c133f573e85d838b8e960",
  "main": "worker-runtime.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "ReminderScheduler" }]
  },
  "migrations": [{ "tag": "reminder-scheduler-v1", "new_sqlite_classes": ["ReminderScheduler"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://leotsouo.github.io",
    "VAPID_SUBJECT": "https://leotsouo.github.io/questnote-pwa/",
    "VAPID_PUBLIC_KEY": "BN47QjgmwezqFS7eQvjvPaZ_GaAZmPwM3FTqnNEXFu9kqSOoyu8nZP1F2HCzuBRRASZSkGjFfu4jX6IfaSm9-zQ"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questnote-reminders",
      "database_id": "d07747b1-1730-49d4-ade6-3a4ffdf7d4f0"
    }
  ],
  "triggers": {
    "crons": [
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE",
      "namespace_id": "209341516",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
