#!/bin/sh
# Run the full check only when pushing to dev or main; other refs (gh-pages, archive/*) pass through.
run_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main) run_check=1 ;;
  esac
done
[ "$run_check" = 1 ] || exit 0
echo "pre-push: running npm run check before pushing to dev/main"
npm run check
